{
  "multipart": [
    {
      "when": {
        "hanging": "false"
      },
      "apply": {
        "model": "sensorlamp:block/sensor_lantern"
      }
    },
    {
      "when": {
        "hanging": "true"
      },
      "apply": {
        "model": "sensorlamp:block/sensor_lantern_hanging"
      }
    },
    {
      "when": {
        "hanging": "false",
        "powered": "false"
      },
      "apply": {
        "model": "sensorlamp:block/sensor_lantern_off_overlay"
      }
    },
    {
      "when": {
        "hanging": "true",
        "powered": "false"
      },
      "apply": {
        "model": "sensorlamp:block/sensor_lantern_hanging_off_overlay"
      }
    }
  ]
}
