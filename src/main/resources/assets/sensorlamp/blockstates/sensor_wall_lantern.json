{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "sensorlamp:block/sensor_wall_lantern"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "sensorlamp:block/sensor_wall_lantern",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "sensorlamp:block/sensor_wall_lantern",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "sensorlamp:block/sensor_wall_lantern",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "powered": "false"
      },
      "apply": {
        "model": "sensorlamp:block/sensor_lantern_hanging_off_overlay"
      }
    },
    {
      "when": {
        "facing": "east",
        "powered": "false"
      },
      "apply": {
        "model": "sensorlamp:block/sensor_lantern_hanging_off_overlay",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "powered": "false"
      },
      "apply": {
        "model": "sensorlamp:block/sensor_lantern_hanging_off_overlay",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "powered": "false"
      },
      "apply": {
        "model": "sensorlamp:block/sensor_lantern_hanging_off_overlay",
        "y": 270
      }
    }
  ]
}
